    },
    {
      "page": "/register",
      "regex": "^/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/register(?:/)?$"
    },
    {
      "page": "/register/discount",
      "regex": "^/register/discount(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/register/discount(?:/)?$"
    },
    {
      "page": "/sessions",
      "regex": "^/sessions(?:/)?$",
