{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/api/content/[key]",
      "regex": "^/api/content/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPkey": "nxtPkey"
      },
      "namedRegex": "^/api/content/(?<nxtPkey>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/media/[id]",
      "regex": "^/api/media/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/media/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/speakers/[id]",
      "regex": "^/api/speakers/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/speakers/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/sessions/[themeId]",
      "regex": "^/sessions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPthemeId": "nxtPthemeId"
      },
      "namedRegex": "^/sessions/(?<nxtPthemeId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/abstract-submission",
